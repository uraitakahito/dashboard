# dashboard の設定。
#
# **このファイルを写す必要は無い。** 下の行は全部コメントで、既定値だけで動く ——
# `.env` を作るのは「誰として見るか」か「どこを見るか」を変えるときだけ。
# 変えるなら `cp -n .env.example .env` で写して、要る行のコメントを外す。
#
# **秘密は 1 つも無い。** 台帳へ名乗るトークンは、開発用 issuer の POST /token から
# 起動のたびに取る。ここに書くのは「誰として見るか」と「どこを見るか」だけ。
#
# 空文字は「無い」と同じ意味に揃えてある (POSIX の ${VAR:-word} 側)。値を書かない
# なら行ごとコメントにすること。

# 画面の待受。**loopback にだけ bind する。** この画面は台帳のトークンを持つので、
# 届く相手はこの機械の中だけでよい。
#DASHBOARD_PORT=7080

# 台帳の API。host から叩くので loopback —— コンテナの名前は node から届かない
# (macOS 26 は Apple 署名でないバイナリをコンテナの subnet へ通さない)。
#DASHBOARD_LEDGER_URL=http://127.0.0.1:7070

# 開発用 issuer。capture-ledger の `pnpm run oidc:issuer` が立てるもの。
#DASHBOARD_ISSUER_URL=http://127.0.0.1:9099

# 誰として見るか。既定はこの機械のユーザー名。
# **この名前に、その組織のクロールの許可が要る**:
#   cd ../capture-ledger && pnpm run fga:grant submitter <名前> acme
#DASHBOARD_SUBJECT=
# 名乗る組織 (カンマ区切り)。
#DASHBOARD_ORGANIZATIONS=acme

# 深いリンクの行き先。画面が組み立てず、ここで決める。
#DASHBOARD_REPLAY_URL=http://127.0.0.1:8899
#DASHBOARD_WINDMILL_URL=http://127.0.0.1:8000
#DASHBOARD_WINDMILL_WORKSPACE=crawler
